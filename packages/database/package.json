{
  "name": "@posie/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node ./scripts/prepare-schema.js && prisma generate",
    "db:generate": "node ./scripts/prepare-schema.js && prisma generate",
    "db:push": "node ./scripts/prepare-schema.js && prisma db push",
    "db:deploy": "node ./scripts/prepare-schema.js && prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:use:postgres": "node ./scripts/switch-provider.js postgresql",
    "db:use:sqlite": "node ./scripts/switch-provider.js sqlite"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
