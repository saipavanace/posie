# ==============================================================================
# POSIE PRODUCTION ENVIRONMENT CONFIGURATION (Vercel + Supabase / Neon PostgreSQL)
# ==============================================================================
# Copy these values into your Vercel Project Settings > Environment Variables
# Or into your production hosting environment.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - Neon or Supabase)
# ------------------------------------------------------------------------------
# SUPABASE SETUP:
# In Supabase Project Settings > Database:
# - DATABASE_URL (Session pooler, port 5432 or 6543):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# - DIRECT_URL (Direct connection, port 5432 - used for schema push/migrations):
#   postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
#
# NEON SETUP:
# In Neon Console > Dashboard > Connection Details:
# - Check "Pooled connection" for DATABASE_URL:
#   postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require
# - Uncheck "Pooled connection" for DIRECT_URL:
#   postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require

DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Explicitly set Prisma provider to postgresql for production
PRISMA_DATABASE_PROVIDER="postgresql"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key using:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-64-character-hex-string-for-production"

# ------------------------------------------------------------------------------
# 3. APPLICATION DOMAIN
# ------------------------------------------------------------------------------
# Set to your primary production canonical URL (e.g. Vercel deployment URL or custom domain)
NEXT_PUBLIC_APP_URL="https://posie.vercel.app"

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT RAILS (Connect, Terminal & Elements)
# ------------------------------------------------------------------------------
# In Stripe Dashboard (https://dashboard.stripe.com/apikeys):
# - STRIPE_SECRET_KEY (sk_live_... or sk_test_...):
#   Server-side key for PaymentIntents, Connect onboarding, and Terminal tokens
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_live_... or pk_test_...):
#   Client-side key for Stripe Elements card tokenization
# - STRIPE_WEBHOOK_SECRET (whsec_...):
#   In Stripe Dashboard > Developers > Webhooks > Add endpoint:
#   Endpoint URL: https://[your-domain]/api/webhooks/stripe
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_stripe_webhook_secret"

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS: TWILIO SMS & RESEND TRANSACTIONAL EMAIL
# ------------------------------------------------------------------------------
# In Twilio Console (https://console.twilio.com):
# - TWILIO_ACCOUNT_SID: Live Account SID (starts with AC...)
# - TWILIO_AUTH_TOKEN: Live Auth Token
# - TWILIO_PHONE_NUMBER: 10DLC-registered phone number (+1...)
TWILIO_ACCOUNT_SID="AC_replace_with_your_twilio_account_sid"
TWILIO_AUTH_TOKEN="replace_with_your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+12125550199"

# In Resend Dashboard (https://resend.com/api-keys):
# - RESEND_API_KEY: re_...
# - RESEND_FROM_EMAIL: concierge@yourcustomdomain.com or onboarding@resend.dev
RESEND_API_KEY="re_replace_with_your_resend_api_key"
RESEND_FROM_EMAIL="concierge@atelierposie.com"

# ------------------------------------------------------------------------------
# 6. CLOUD MEDIA STORAGE (AWS S3 or Cloudflare R2)
# ------------------------------------------------------------------------------
# For AWS S3:
# - AWS_ACCESS_KEY_ID: IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject
# - AWS_SECRET_ACCESS_KEY: IAM user secret key
# - AWS_REGION: e.g. us-east-1
# - AWS_S3_BUCKET: Bucket name (e.g. posie-media-assets)
#
# For Cloudflare R2:
# - AWS_ACCESS_KEY_ID: Cloudflare R2 Token Access Key ID
# - AWS_SECRET_ACCESS_KEY: Cloudflare R2 Token Secret Access Key
# - AWS_REGION: auto (or us-east-1)
# - AWS_S3_BUCKET: R2 bucket name
# - CLOUDFLARE_R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
# - NEXT_PUBLIC_CDN_URL: https://cdn.atelierposie.com (custom public domain for R2)
AWS_ACCESS_KEY_ID="replace_with_your_aws_or_r2_access_key"
AWS_SECRET_ACCESS_KEY="replace_with_your_aws_or_r2_secret_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="posie-media-assets"
# CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# NEXT_PUBLIC_CDN_URL="https://cdn.atelierposie.com"

# Node Environment
NODE_ENV="production"
